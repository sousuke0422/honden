# ── 隔離（床）─────────────────────────────────────────
#
# 足軽の CLI を、網を縛った名前空間の中で起こす。
# **書かねば今の状態（隔離なし）。** 書き方は fw 機器の流儀——既定拒否・明示許可。
#
# v1 が縛るのは網だけ: 母屋の loopback（127.0.0.1 で待つ常駐の口)へ届かず、
# 外（記事・git・API）へは届く。要る道具: bwrap と passt（pasta）。
#
# 未実装の段（systemd-run / lxc）は予約語で、書けば**出陣が止まる**。
# 口ごとの粒度（tcp/443）も v1 では支えられぬゆえ受けぬ——
# 書いたとおりに縛れぬ規則を黙って通すと、書いた者は守られたつもりになる。
#
# 効き目は `honden isolate check` で測る（中から何に届くかを見る・陰性対照つき）。
#
# isolation:
#   level: bwrap            # none | bwrap | systemd-run(予約) | lxc(予約)
#   net:
#     default: deny
#     allow:
#       - outbound          # 外は全開。母屋の口だけ塞がる
#
# fw 機器の流儀で口を絞るなら（outbound とは混ぜられぬ）:
#
#   net:
#     default: deny
#     allow:
#       - tcp/443           # 許した TCP の口へしか connect できぬ（honden-cage / Landlock）
#       - tcp/80
#
# udp/<口> は受けぬ——Landlock の網は TCP だけで、縛れぬ規則を受けると
# 書いた者は守られたつもりになる。宛先も見ぬ（口だけ）。

# file の縛り（cmd_2 の実測調査に基づく）。書かねば file は素通し（今の状態）。
# 書けば「書けるのは write の道と /tmp（専有）だけ、他は全部 ro」になる。
# CLI の起動に要る道（~/.claude 等）は出陣が CLI 名から自動で足す。
# rw の道に .git が在れば hooks と config だけ ro で重なる（commit はできる）。
#
#   fs:
#     default: deny
#     write:
#       - /path/to/repo
#       - ~/.honden
