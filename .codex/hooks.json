{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "HONDEN_GUARD_TRACE=\"$HOME/.honden/guard-trace.log\" bash /mnt/c/Users/aki/work/honden/.codex/hooks/guard.sh",
            "timeout": 10,
            "statusMessage": "禁じ手の門で検めておる"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /mnt/c/Users/aki/work/honden/.codex/hooks/session-start.sh",
            "timeout": 10,
            "statusMessage": "名乗りと作法を確かめておる"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /mnt/c/Users/aki/work/honden/.codex/hooks/session-start.sh",
            "timeout": 10,
            "statusMessage": "圧縮の後に名乗りを言い直す"
          }
        ]
      }
    ]
  }
}
